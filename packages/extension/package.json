{
  "name": "sql-engine-lab",
  "displayName": "SQL Engine Laboratory",
  "description": "Levanta motores SQL con un clic desde VS Code. PostgreSQL, MySQL, MariaDB, SQLite, Oracle y SQL Server listos para usar sin tocar Docker.",
  "version": "0.1.0",
  "publisher": "sqlenginelab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "sql",
    "database",
    "postgresql",
    "mysql",
    "mariadb",
    "sqlite",
    "oracle",
    "sqlserver",
    "docker",
    "laboratory"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "icon": "resources/icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sql-engine-lab",
          "title": "SQL Engine Lab",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "sql-engine-lab": [
        {
          "id": "sqlEngineLab.engineList",
          "name": "Motores SQL",
          "icon": "resources/icon.svg",
          "contextualTitle": "SQL Engine Lab"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sqlEngineLab.engineList",
        "contents": "SQL Engine Laboratory se está inicializando.\n\nPor favor, completa el proceso de verificación de Docker en la pestaña de inicio para desbloquear los motores.\n[Mostrar Inicio](command:sqlEngineLab.showHome)",
        "when": "!sqlEngineLab.isReady"
      }
    ],
    "commands": [
      {
        "command": "sqlEngineLab.startEngine",
        "title": "Iniciar Motor",
        "category": "SQL Engine Lab",
        "icon": "$(play)"
      },
      {
        "command": "sqlEngineLab.stopEngine",
        "title": "Detener Motor",
        "category": "SQL Engine Lab",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sqlEngineLab.showConnectionInfo",
        "title": "Ver Info de Conexión",
        "category": "SQL Engine Lab",
        "icon": "$(info)"
      },
      {
        "command": "sqlEngineLab.copyConnectionCommand",
        "title": "Copiar Comando de Conexión",
        "category": "SQL Engine Lab",
        "icon": "$(copy)"
      },
      {
        "command": "sqlEngineLab.refreshEngines",
        "title": "Refrescar",
        "category": "SQL Engine Lab",
        "icon": "$(refresh)"
      },
      {
        "command": "sqlEngineLab.configureCredentials",
        "title": "Configurar Credenciales",
        "category": "SQL Engine Lab",
        "icon": "$(gear)"
      },
      {
        "command": "sqlEngineLab.showDiagnostics",
        "title": "Diagnóstico del Entorno (Doctor)",
        "category": "SQL Engine Lab",
        "icon": "$(pulse)"
      },
      {
        "command": "sqlEngineLab.newSqlSheet",
        "title": "Nueva Hoja SQL",
        "category": "SQL Engine Lab",
        "icon": "$(add)"
      },
      {
        "command": "sqlEngineLab.runSql",
        "title": "Ejecutar Query",
        "category": "SQL Engine Lab",
        "icon": "$(play)"
      },
      {
        "command": "sqlEngineLab.changeConnection",
        "title": "Cambiar Conexión SQL",
        "category": "SQL Engine Lab",
        "icon": "$(plug)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sqlEngineLab.configureCredentials",
          "when": "view == sqlEngineLab.engineList && sqlEngineLab.isReady",
          "group": "navigation@1"
        },
        {
          "command": "sqlEngineLab.refreshEngines",
          "when": "view == sqlEngineLab.engineList && sqlEngineLab.isReady",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sqlEngineLab.startEngine",
          "when": "view == sqlEngineLab.engineList && viewItem == engine-stopped && sqlEngineLab.isReady",
          "group": "inline"
        },
        {
          "command": "sqlEngineLab.stopEngine",
          "when": "view == sqlEngineLab.engineList && viewItem == engine-running && sqlEngineLab.isReady",
          "group": "inline"
        },
        {
          "command": "sqlEngineLab.showConnectionInfo",
          "when": "view == sqlEngineLab.engineList && viewItem == engine-running && sqlEngineLab.isReady",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "sqlEngineLab.runSql",
          "when": "resourceLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "sqlEngineLab.changeConnection",
          "when": "resourceLangId == sql",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "SQL Engine Lab",
      "properties": {
        "sqlEngineLab.credentials.labUser": {
          "type": "string",
          "default": "labuser",
          "description": "Usuario estándar por defecto del laboratorio."
        },
        "sqlEngineLab.credentials.labPassword": {
          "type": "string",
          "default": "LabPassword123!",
          "description": "Contraseña estándar por defecto. En motores como SQL Server u Oracle, esta también es la contraseña del administrador."
        },
        "sqlEngineLab.credentials.labDatabase": {
          "type": "string",
          "default": "labdb",
          "description": "Base de datos por defecto del laboratorio."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile:test": "tsc -p ./tsconfig.test.json",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run compile:test",
    "test": "node ./out_test/test/runTest.js",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "package": "vsce package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "mocha": "^10.2.0",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "dockerode": "^4.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
