{
  "docker": {
    "imageName": "sql-engine-lab",
    "imageTag": "dev",
    "containerName": "sql-engine-lab"
  },
  "defaultEnv": {
    "LAB_USER": "labuser",
    "LAB_PASSWORD": "LabPassword123!",
    "LAB_DATABASE": "labdb"
  },
  "engines": {
    "postgres": {
      "id": "postgres",
      "displayName": "PostgreSQL",
      "description": "Base de datos relacional open-source, robusta y extensible",
      "defaultPort": 5432,
      "dockerEnvValue": "postgres",
      "healthcheckCmd": "pg_isready -h localhost -p 5432 -U \"${LAB_USER}\" -d \"${LAB_DATABASE}\"",
      "connectionTemplate": {
        "command": "psql",
        "argsTemplate": "-h {host} -p {port} -U {user} -d {database}",
        "defaultUser": "labuser",
        "defaultPassword": "LabPassword123!",
        "defaultDatabase": "labdb",
        "adminUser": "postgres",
        "adminPassword": "LabPassword123!",
        "adminPasswordMessage": "Misma que el usuario del laboratorio",
        "testCommands": [
          "SELECT version();",
          "CREATE TABLE test (id serial PRIMARY KEY, nombre varchar(50));",
          "INSERT INTO test (nombre) VALUES ('Hola Lab');",
          "SELECT * FROM test;"
        ]
      },
      "healthcheckTimeoutMs": 15000,
      "startupSpeed": "fast",
      "iconId": "database"
    },
    "mysql": {
      "id": "mysql",
      "displayName": "MySQL",
      "description": "Base de datos relacional open-source, la más popular del mundo",
      "defaultPort": 3306,
      "dockerEnvValue": "mysql",
      "healthcheckCmd": "mysqladmin ping -h 127.0.0.1 -P 3306 -u \"${LAB_USER}\" --password=\"${LAB_PASSWORD}\"",
      "connectionTemplate": {
        "command": "mysql",
        "argsTemplate": "-h {host} -P {port} -u {user} -p{password} {database}",
        "defaultUser": "labuser",
        "defaultPassword": "LabPassword123!",
        "defaultDatabase": "labdb",
        "adminUser": "root",
        "adminPasswordRequiresInput": true,
        "adminPasswordMessage": "Sin contraseña por defecto en localhost",
        "testCommands": [
          "SELECT VERSION();",
          "CREATE TABLE test (id INT AUTO_INCREMENT PRIMARY KEY, nombre VARCHAR(50));",
          "INSERT INTO test (nombre) VALUES ('Hola Lab');",
          "SELECT * FROM test;"
        ]
      },
      "healthcheckTimeoutMs": 20000,
      "startupSpeed": "fast",
      "iconId": "database"
    },
    "mariadb": {
      "id": "mariadb",
      "displayName": "MariaDB",
      "description": "Fork open-source de MySQL, compatible y con mejoras de rendimiento",
      "defaultPort": 3307,
      "dockerEnvValue": "mariadb",
      "healthcheckCmd": "mariadb-admin ping -h 127.0.0.1 -P 3307 -u \"${LAB_USER}\" --password=\"${LAB_PASSWORD}\"",
      "connectionTemplate": {
        "command": "mariadb",
        "argsTemplate": "-h {host} -P {port} -u {user} -p{password} {database}",
        "defaultUser": "labuser",
        "defaultPassword": "LabPassword123!",
        "defaultDatabase": "labdb",
        "adminUser": "root",
        "adminPassword": "",
        "adminPasswordRequiresInput": true,
        "adminPasswordMessage": "Sin contraseña por defecto en localhost",
        "testCommands": [
          "SELECT VERSION();",
          "CREATE TABLE test (id INT AUTO_INCREMENT PRIMARY KEY, nombre VARCHAR(50));",
          "INSERT INTO test (nombre) VALUES ('Hola Lab');",
          "SELECT * FROM test;"
        ]
      },
      "healthcheckTimeoutMs": 20000,
      "startupSpeed": "fast",
      "iconId": "database"
    },
    "oracle": {
      "id": "oracle",
      "displayName": "Oracle Free",
      "description": "Oracle Database Free 23ai — motor enterprise con licencia gratuita para desarrollo",
      "defaultPort": 1521,
      "dockerEnvValue": "oracle",
      "dockerShmSize": 1073741824,
      "healthcheckCmd": "sqlplus -s /nolog << SQLEOF\\nWHENEVER SQLERROR EXIT FAILURE;\\nWHENEVER OSERROR EXIT FAILURE;\\nCONNECT \"${LAB_USER}\"/\"${LAB_PASSWORD}\"@localhost:1521/FREEPDB1\\nSELECT 1 FROM DUAL;\\nEXIT;\\nSQLEOF",
      "connectionTemplate": {
        "command": "sqlplus",
        "argsTemplate": "{user}/{password}@{host}:{port}/FREEPDB1",
        "defaultUser": "labuser",
        "defaultPassword": "LabPassword123!",
        "defaultDatabase": "FREEPDB1",
        "adminUser": "sys as sysdba",
        "adminPassword": "LabPassword123!",
        "adminPasswordMessage": "Misma que el usuario del laboratorio",
        "testCommands": [
          "SELECT * FROM v$version;",
          "CREATE TABLE test (id NUMBER GENERATED BY DEFAULT AS IDENTITY, nombre VARCHAR2(50));",
          "INSERT INTO test (nombre) VALUES ('Hola Lab');",
          "SELECT * FROM test;"
        ]
      },
      "healthcheckTimeoutMs": 300000,
      "startupSpeed": "slow",
      "iconId": "database"
    },
    "sqlserver": {
      "id": "sqlserver",
      "displayName": "SQL Server",
      "description": "Microsoft SQL Server Developer — motor enterprise gratuito para desarrollo",
      "defaultPort": 1433,
      "dockerEnvValue": "sqlserver",
      "healthcheckCmd": "/opt/mssql-tools18/bin/sqlcmd -S localhost,1433 -U sa -P \"${LAB_PASSWORD}\" -Q \"SELECT 1\" -C -b",
      "connectionTemplate": {
        "command": "sqlcmd",
        "argsTemplate": "-S {host},{port} -U {user} -P {password} -d {database} -C",
        "defaultUser": "labuser",
        "defaultPassword": "LabPassword123!",
        "defaultDatabase": "labdb",
        "adminUser": "sa",
        "adminPassword": "LabPassword123!",
        "adminPasswordMessage": "Misma que el usuario del laboratorio",
        "testCommands": [
          "SELECT @@VERSION;",
          "CREATE TABLE test (id INT IDENTITY(1,1) PRIMARY KEY, nombre VARCHAR(50));",
          "INSERT INTO test (nombre) VALUES ('Hola Lab');",
          "SELECT * FROM test;"
        ]
      },
      "healthcheckTimeoutMs": 60000,
      "startupSpeed": "slow",
      "iconId": "database"
    },
    "sqlite": {
      "id": "sqlite",
      "displayName": "SQLite",
      "description": "Motor embebido ultraliviano — no requiere servidor, ideal para prototipos",
      "defaultPort": 0,
      "dockerEnvValue": "sqlite",
      "healthcheckCmd": "test -f /var/lib/sql-engine-lab/data/sqlite/${LAB_DATABASE}.sqlite",
      "connectionTemplate": {
        "command": "sqlite3",
        "argsTemplate": "/var/lib/sql-engine-lab/data/sqlite/{database}.sqlite",
        "defaultUser": "",
        "defaultPassword": "",
        "defaultDatabase": "labdb",
        "testCommands": [
          ".version",
          "CREATE TABLE test (id INTEGER PRIMARY KEY AUTOINCREMENT, nombre TEXT);",
          "INSERT INTO test (nombre) VALUES ('Hola Lab');",
          "SELECT * FROM test;"
        ]
      },
      "healthcheckTimeoutMs": 15000,
      "startupSpeed": "fast",
      "iconId": "file"
    }
  }
}
